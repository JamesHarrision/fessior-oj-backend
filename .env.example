# Runtime
NODE_ENV=development
LOG_LEVEL=debug

# API server
API_PORT=3000

# Worker server
WORKER_CONCURRENCY=2

# MySQL container
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=local_root_password
MYSQL_DATABASE=fessior_oj
MYSQL_USER=fessior
MYSQL_PASSWORD=fessior_dev_password

# Prisma connection from applications running on Windows
DATABASE_URL=mysql://fessior:fessior_dev_password@localhost:3306/fessior_oj

# Redis container
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379