{
  "name": "fessior-oj-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "check": "turbo run check",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "infra:up": "docker compose --env-file .env -f infrastructure/docker-compose.yml up -d",
    "infra:down": "docker compose --env-file .env -f infrastructure/docker-compose.yml down",
    "infra:status": "docker compose --env-file .env -f infrastructure/docker-compose.yml ps",
    "infra:logs": "docker compose --env-file .env -f infrastructure/docker-compose.yml logs -f",
    "db:generate": "pnpm --filter @fessior/database prisma:generate",
    "db:validate": "pnpm --filter @fessior/database prisma:validate",
    "db:format": "pnpm --filter @fessior/database prisma:format",
    "db:migrate": "pnpm --filter @fessior/database db:migrate",
    "db:status": "pnpm --filter @fessior/database db:status",
    "db:studio": "pnpm --filter @fessior/database db:studio",
    "db:test": "pnpm --filter @fessior/database db:test"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.17.0",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "turbo": "^2.10.7"
  }
}