# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=ocj_root_secret
MYSQL_DATABASE=ocj_main_db
MYSQL_USER=ocj_user
MYSQL_PASSWORD=ocj_secret_pass

# Application Core Configuration
PORT=6868
DATABASE_URL=mysql://root:ocj_root_secret@mysql:3306/ocj_main_db
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Security Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# SMTP Email Configuration (Optional - used for password reset)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password

# Gemini AI Integration API Key (Optional - used by the chatbox)
GEMINI_API_KEY=your_gemini_api_key_here

# Judge0 Code Execution API (Optional - simulation mode runs if empty)
RAPIDAPI_KEY=
RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
